833 -33 L
833 800 L
0 800 L
0 -33 L
cp
clip
GS
0 0 translate
800 800 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 800
  /ImageMatrix [800 0 0 800 0 0]
  /Width 800
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
